{
  "name": "notion-elements-files-widget-staging",
  "version": "2.0.0-staging.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node backend/server.mjs",
    "test": "node --test backend/test/*.test.mjs frontend/test/*.test.mjs migration/test/*.test.mjs",
    "test:backend": "node --test backend/test/*.test.mjs",
    "test:frontend": "node --test frontend/test/*.test.mjs",
    "test:migration": "node --test migration/test/*.test.mjs",
    "audit:dry": "node migration/cli.mjs audit",
    "migrate:plan": "node migration/cli.mjs plan"
  }
}
