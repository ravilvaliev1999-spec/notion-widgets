{
  "version": 2,
  "title": "Элементы",
  "creationStrategy": "Clone the sandbox copy of the current Tasks data source, then rewire every relation to sandbox IDs before adding new properties.",
  "preserveFromTasks": [
    "Name",
    "Статус",
    "Приоритет",
    "Дата",
    "Ответственный",
    "Маркетплейс",
    "Ссылка",
    "Вложения",
    "3. Проекты",
    "Parent item",
    "Sub-item",
    "Итоговый статус",
    "Прогресс задачи",
    "Проект задачи",
    "Связь",
    "Направление",
    "Сфера",
    "Подзадач всего",
    "Подзадачи готово",
    "[SYS] База: Счетчик",
    "[SYS] Готова",
    "[SYS] Общая группа",
    "[SYS] Очередь",
    "[SYS] Приоритет балл",
    "[SYS] Приоритет задан",
    "[SYS] Флаг: В работе",
    "[SYS] Флаг: Готово"
  ],
  "properties": {
    "Тип": { "type": "select", "options": ["Задача", "Знание", "Раздел"], "emptyMeans": "Входящие" },
    "Избранное": { "type": "checkbox" },
    "Категория знания": { "type": "select", "options": ["Книга", "Концепция", "Инструкция", "Видео", "Инсайт", "Шаблон", "Ссылка"] },
    "Формат знания": { "type": "select", "options": ["Файл", "Ссылка", "Заметка", "Инструкция", "Медиа"] },
    "Архив": { "type": "checkbox" },
    "Внутри": { "type": "self_relation", "limit": 1, "reciprocal": "Содержимое" },
    "Содержимое": { "type": "self_relation_reciprocal" },
    "Знание: Сфера": { "type": "relation", "target": "sandbox.spheresDataSourceId", "limit": 1 },
    "Знание: Направление": { "type": "relation", "target": "sandbox.directionsDataSourceId", "limit": 1 },
    "Знание: Проект": { "type": "relation", "target": "sandbox.projectsDataSourceId", "limit": 1 },
    "[SYS] Прямых мест": { "type": "formula", "expression": "prop(\"Внутри\").length() + prop(\"Знание: Проект\").length() + prop(\"Знание: Направление\").length() + prop(\"Знание: Сфера\").length()" },
    "[SYS] Внутри: Тип": { "type": "formula", "expression": "if(empty(prop(\"Внутри\")), \"\", prop(\"Внутри\").first().prop(\"Тип\"))" },
    "[SYS] Ошибка размещения": { "type": "formula", "contract": "Inbox has 0 direct placements; Knowledge/Section has exactly 1; Knowledge Inside points to Task/Section; Section Inside points only to Section." },
    "[SYS] Ошибка типа": { "type": "formula", "contract": "Knowledge/Section/Inbox must not contain task-only Status, Priority, Projects or Parent/Sub-item values." },
    "[SYS] Вид элемента": { "type": "formula", "expression": "if(empty(prop(\"Тип\")), \"Входящие\", prop(\"Тип\"))" },
    "[SYS] Контекст: Сфера": { "type": "relation", "target": "sandbox.spheresDataSourceId", "limit": 1, "hidden": true },
    "[SYS] Контекст: Направление": { "type": "relation", "target": "sandbox.directionsDataSourceId", "limit": 1, "hidden": true },
    "[SYS] Контекст: Проект": { "type": "relation", "target": "sandbox.projectsDataSourceId", "limit": 1, "hidden": true },
    "[SYS] Context path": { "type": "rich_text", "hidden": true },
    "[SYS] Ancestor IDs": { "type": "rich_text", "format": "JSON array", "hidden": true },
    "[SYS] Глубина": { "type": "number", "hidden": true },
    "[SYS] Контекст обновлён": { "type": "date", "hidden": true },
    "[SYS] Раздел виджета": { "type": "select", "options": ["Drive", "Docs", "Sheets", "Slides"], "hidden": true },
    "[SYS] Формат файла": { "type": "select", "options": ["Google Docs", "Word", "Google Sheets", "Excel", "CSV", "Google Slides", "PowerPoint", "Link", "Other File"], "hidden": true },
    "[SYS] Провайдер": { "type": "select", "options": ["Google Drive", "External URL", "Notion"], "hidden": true },
    "[SYS] Google File ID": { "type": "rich_text", "hidden": true },
    "[SYS] Google Folder ID": { "type": "rich_text", "hidden": true },
    "[SYS] MIME type": { "type": "rich_text", "hidden": true },
    "[SYS] Download name": { "type": "rich_text", "hidden": true },
    "[SYS] Размер байт": { "type": "number", "hidden": true },
    "[SYS] SHA-256": { "type": "rich_text", "hidden": true },
    "[SYS] Drive MD5": { "type": "rich_text", "hidden": true },
    "[SYS] Позиция": { "type": "number", "hidden": true },
    "[SYS] Sync status": { "type": "select", "options": ["pending", "synced", "error", "archived", "unlinked", "deleted", "needs_review"], "hidden": true },
    "[SYS] Последняя синхронизация": { "type": "date", "hidden": true },
    "[SYS] Ошибка sync": { "type": "rich_text", "hidden": true },
    "[SYS] Normalized URL": { "type": "rich_text", "hidden": true },
    "[SYS] Idempotency key": { "type": "rich_text", "hidden": true },
    "[SYS] Task Page ID": { "type": "formula", "hidden": true },
    "[SYS] Knowledge key": { "type": "formula", "contract": "task_page_id|g|google_file_id OR task_page_id|u|normalized_url", "hidden": true },
    "[SYS] Integrity": { "type": "select", "options": ["ok", "duplicate", "context_error", "sync_error"], "hidden": true },
    "[MIG] Источник": { "type": "select", "options": ["Tasks", "Knowledge", "Legacy Files", "Manual"], "hidden": true },
    "[MIG] Source Page ID": { "type": "rich_text", "hidden": true },
    "[MIG] Source Data Source ID": { "type": "rich_text", "hidden": true },
    "[MIG] Source URL": { "type": "url", "hidden": true },
    "[MIG] Batch": { "type": "rich_text", "hidden": true },
    "[MIG] Статус": { "type": "select", "options": ["not_started", "copied", "relations_mapped", "verified", "needs_review", "error"], "hidden": true },
    "[MIG] Legacy Тип": { "type": "rich_text", "hidden": true },
    "[MIG] Legacy Статус": { "type": "rich_text", "hidden": true },
    "[MIG] Content hash": { "type": "rich_text", "hidden": true }
  },
  "statusPolicy": {
    "taskOnly": true,
    "groups": { "toDo": ["Идея", "Бэклог"], "inProgress": ["В работе", "Ждет"], "complete": ["Готово"] },
    "legacyKnowledgeOption": "Migrate every row with Статус=Знание to Тип=Знание, assign exactly one placement, clear Статус, verify, then remove the option in sandbox only."
  },
  "views": [
