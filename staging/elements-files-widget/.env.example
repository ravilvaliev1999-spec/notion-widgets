APP_ENV=staging
PORT=8787
# Backend serves the widget and API from one origin.
PUBLIC_BASE_URL=https://staging-widget.example.com
WIDGET_PUBLIC_URL=https://staging-widget.example.com/index.html
ALLOWED_ORIGINS=https://staging-widget.example.com,http://localhost:8787

# Sandbox Notion only. Never reuse the source-workspace token here.
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
SANDBOX_WORKSPACE_ID=
SANDBOX_PARENT_PAGE_ID=
ELEMENTS_DATA_SOURCE_ID=

# Staging Drive folder only.
STAGING_DRIVE_FOLDER_ID=
# Exact value in appProperties.elementsStagingBoundary or the root marker file.
STAGING_DRIVE_MARKER=
GOOGLE_EXPECTED_ACCOUNT_EMAIL=staging-owner@example.com
ORIGINAL_DRIVE_DENYLIST_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Generate at least 32 random bytes. This value is server-side only.
TOKEN_SIGNING_SECRET=
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Widget writes are enabled only when both guards are open and every target is allowlisted.
WRITE_GATE=closed
DRY_RUN=true
DRIVE_RENAME_SYNC_MS=45000
EMBED_RENEWAL_MS=86400000
