APP_ENV=staging
PORT=8787
# Backend serves the widget and API from one origin.
PUBLIC_BASE_URL=https://staging-widget.example.com
WIDGET_PUBLIC_URL=https://staging-widget.example.com/index.html
ALLOWED_ORIGINS=https://staging-widget.example.com,http://localhost:8787

# Staging runtime, explicitly authorized to the main Elements target only.
# Keep the integration scoped to Elements and its task pages. Legacy data
# sources remain denied even though they live in the same workspace.
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
TARGET_PROFILE=authorized-main
AUTHORIZED_NOTION_WORKSPACE_ID=ed4b491d-ab6b-449d-bd9a-7b7992281f96
AUTHORIZED_ELEMENTS_DATABASE_ID=3822d627-39a1-807a-966d-f43585d75212
ELEMENTS_DATA_SOURCE_ID=3822d627-39a1-8018-a2dc-000b95bf5722
AUTHORIZED_TASK_TEMPLATE_PAGE_ID=3832d627-39a1-8026-9d86-d4b40101c0d7
AUTHORIZED_CANARY_TASK_PAGE_ID=3ae2d627-39a1-80ad-b49c-e028699b75d9
SPHERES_DATA_SOURCE_ID=3822d627-39a1-8052-9ef1-000bc10b8f68
DIRECTIONS_DATA_SOURCE_ID=3822d627-39a1-8069-9637-000ba20c3b1d
PROJECTS_DATA_SOURCE_ID=3822d627-39a1-8068-aafa-000b9db5ed1c
LEGACY_NOTION_DENYLIST_IDS=

# Staging Drive folder only.
STAGING_DRIVE_FOLDER_ID=
# Exact value in appProperties.elementsStagingBoundary or the root marker file.
STAGING_DRIVE_MARKER=
GOOGLE_EXPECTED_ACCOUNT_EMAIL=staging-owner@example.com
ORIGINAL_DRIVE_DENYLIST_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Generate at least 32 random bytes. This value is server-side only.
TOKEN_SIGNING_SECRET=
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Widget writes are enabled only when both guards are open and every target is
# allowlisted. These pre-acceptance defaults permit only the canary task.
WRITE_GATE=closed
DRY_RUN=true
ACCEPTANCE_APPROVED=false
TASK_WRITE_SCOPE=canary
EMBED_ROLLOUT_PHASE=disabled
ENABLE_NEW_TASK_WEBHOOK=false
ALLOW_RELATION_UNLINK=false
ALLOW_DRIVE_TRASH=false
DRIVE_RENAME_SYNC_MS=45000
EMBED_RENEWAL_MS=86400000
